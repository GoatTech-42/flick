:root{--color-ink:#171310;--color-panel:#221c16;--color-line:#342a20;--color-text:#e8e2da;--color-muted:#9a9086;--amber:#ffa028;--lightningcss-light: ;--lightningcss-dark:initial;color-scheme:dark}*{box-sizing:border-box}html,body{background:var(--color-ink);color:var(--color-text);margin:0;padding:0;font:15px/1.45 system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Noto Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif}#app{min-height:100vh}.dim{color:var(--color-muted)}.btn{border:1px solid var(--color-line);background:var(--color-panel);color:var(--color-text);cursor:pointer;border-radius:999px;align-items:center;gap:6px;padding:8px 14px;font-size:13.5px;display:inline-flex}.btn:hover{background:var(--color-ink)}.btn.amber{background:var(--amber);border-color:var(--amber);color:#17110a;font-weight:700}.btn.tiny{padding:4px 10px;font-size:12px}input[type=text],select{background:var(--color-panel);border:1px solid var(--color-line);color:var(--color-text);font:inherit;-webkit-appearance:none;appearance:none;border-radius:999px;padding:10px 16px;font-size:14px;line-height:1.2}input:focus,select:focus{border-color:var(--amber);outline:none}.fshell{max-width:1080px;margin:0 auto;padding:0 16px 80px}.fhead{align-items:center;gap:10px;padding:18px 0 10px;display:flex}.fhead h1{margin:0;font-size:24px;font-weight:800}.fmark{color:var(--amber);font-weight:900}.fsearch{gap:8px;margin-left:auto;display:flex}.fsearch input{width:min(280px,46vw)}.fsec{text-transform:uppercase;letter-spacing:.08em;color:var(--color-muted);margin:22px 0 10px;font-size:13px}.fgrid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px;display:grid}.fcard{color:var(--color-text);cursor:pointer;text-align:left;background:0 0;border:0;padding:0}.fcard img{aspect-ratio:2/3;object-fit:cover;background:var(--color-panel);border-radius:12px;width:100%;transition:transform .15s;display:block}.fcard:hover img{transform:scale(1.03)}.fcard .t{text-overflow:ellipsis;white-space:nowrap;margin-top:6px;font-size:12.5px;overflow:hidden}.fcard .y{color:var(--color-muted);font-size:11.5px}.foverlay{z-index:50;background:#000000b3;justify-content:center;align-items:center;padding:16px;display:flex;position:fixed;top:0;bottom:0;left:0;right:0}.fsheet{background:var(--color-panel);border:1px solid var(--color-line);border-radius:16px;width:100%;max-width:720px;max-height:88vh;position:relative;overflow-y:auto}.fsheet .bg{object-fit:cover;opacity:.25;border-radius:16px 16px 0 0;width:100%;height:180px;position:absolute;top:0;bottom:auto;left:0;right:0}.fsheet .inner{padding:22px;position:relative}.fsheet h2{margin:0 0 4px}.fsheet .close{z-index:2;position:absolute;top:12px;right:12px}.fdesc{color:var(--color-muted);margin:10px 0 16px;font-size:13.5px}.feplist{flex-direction:column;gap:6px;max-height:300px;margin-top:10px;display:flex;overflow-y:auto}.fep{border:1px solid var(--color-line);background:var(--color-ink);color:var(--color-text);cursor:pointer;text-align:left;border-radius:10px;align-items:center;gap:10px;padding:8px 12px;font-size:13.5px;display:flex}.fep:hover{border-color:var(--amber)}.fep img{aspect-ratio:16/9;object-fit:cover;background:var(--color-panel);border-radius:6px;width:96px}.fplayer{z-index:60;background:#000;flex-direction:column;display:flex;position:fixed;top:0;bottom:0;left:0;right:0}.fplayer video{flex:1;width:100%;min-height:0}.fpbar{background:#171310e6;align-items:center;gap:12px;padding:10px 16px;display:flex}.fpbar b{font-size:14px}.fpbar .spacer{flex:1}.fplayer .loading{color:var(--color-muted);justify-content:center;align-items:center;display:flex;position:absolute;top:0;bottom:0;left:0;right:0}@media (max-width:640px){.fsearch input{width:34vw}.fgrid{grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px}}
